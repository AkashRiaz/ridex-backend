<%- include("partials/header", { title: title }) %>

<p style="margin: 0 0 15px; font-size: 16px; line-height: 1.6;">
  Hello <strong><%= name %></strong>,
</p>

<% if (body) { %>
<p style="margin: 0 0 25px; font-size: 15px; line-height: 1.7; color: #555555; white-space: pre-line;"><%= body %></p>
<% } %>

<table cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 10px;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #ea580c;">
      <a href="<%= ctaUrl %>" style="display: inline-block; padding: 12px 26px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none;"><%= ctaLabel %></a>
    </td>
  </tr>
</table>

<hr style="border: 0; border-top: 1px solid #eeeeee; margin: 30px 0;" />

<p style="margin: 0; font-size: 12px; line-height: 1.6; color: #888888;">
  You received this email because of your <%= appName %> notification settings.
  <% if (unsubscribeUrl) { %>
  <a href="<%= unsubscribeUrl %>" style="color: #888888;">Unsubscribe from these emails</a>.
  <% } %>
</p>

<%- include("partials/footer") %>
