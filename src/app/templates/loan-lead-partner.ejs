<%- include("partials/header", { title: "New financing lead" }) %>

<p style="margin: 0 0 15px; font-size: 16px; line-height: 1.6;">
  Hello <strong><%= partnerName %></strong>,
</p>

<p style="margin: 0 0 20px; font-size: 15px; line-height: 1.7; color: #555555;">
  A buyer on <%= appName %> asked for financing and agreed (on <%= consentAt %>) to share these details with you.
  Please quote reference <strong><%= reference %></strong> when you reply.
</p>

<%
  const sections = [
    {
      heading: "Applicant",
      rows: [
        ["Name", applicant.name],
        ["Phone", applicant.phone],
        ["Email", applicant.email],
        ["District", applicant.district],
        ["Employment", applicant.employment],
        ["Monthly income", applicant.monthlyIncome],
      ],
    },
    {
      heading: "Vehicle and loan",
      rows: [
        ["Vehicle", vehicle.title],
        ["Location", vehicle.location],
        ["Price", terms.price],
        ["Down payment", terms.downPayment],
        ["Loan amount", terms.loanAmount],
        ["Tenure", terms.tenureMonths + " months"],
        ["Rate used for the estimate", terms.interestRate + "% a year"],
        ["Estimated EMI", terms.estimatedEmi],
      ],
    },
  ];
%>

<% sections.forEach((section) => { %>
<h2 style="margin: 0 0 8px; font-size: 16px;"><%= section.heading %></h2>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 20px; border-top: 1px solid #eeeeee;">
  <% section.rows.filter((row) => row[1]).forEach((row) => { %>
  <tr>
    <td style="padding: 6px 0; font-size: 14px; color: #888888; width: 45%;"><%= row[0] %></td>
    <td style="padding: 6px 0; font-size: 14px; font-weight: 600;"><%= row[1] %></td>
  </tr>
  <% }) %>
</table>
<% }) %>

<% if (applicant.note) { %>
<p style="margin: 0 0 6px; font-size: 14px; color: #888888;">Note from the buyer</p>
<p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; white-space: pre-line;"><%= applicant.note %></p>
<% } %>

<% if (adminNote) { %>
<p style="margin: 0 0 6px; font-size: 14px; color: #888888;">Note from <%= appName %></p>
<p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; white-space: pre-line;"><%= adminNote %></p>
<% } %>

<table cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 10px;">
  <tr>
    <td align="center" style="border-radius: 8px; background-color: #ea580c;">
      <a href="<%= vehicle.url %>" style="display: inline-block; padding: 12px 26px; font-size: 15px; font-weight: 600; color: #ffffff; text-decoration: none;">View the listing</a>
    </td>
  </tr>
</table>

<hr style="border: 0; border-top: 1px solid #eeeeee; margin: 30px 0;" />

<p style="margin: 0; font-size: 12px; line-height: 1.6; color: #888888;">
  You receive these leads as a finance partner of <%= appName %>. The estimate above is not an offer; your own terms apply.
</p>

<%- include("partials/footer") %>
