# ============================================
# App
# ============================================

# Brand name used in API messages and emails. Change here to rebrand.
APP_NAME=RideX
# development | production | test
NODE_ENV=development
# Port the API listens on
PORT=5000
# Public URL of this API (used in callbacks and email links)
BACKEND_URL=http://localhost:5000
# Main frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS whitelist. Defaults to FRONTEND_URL. Also used by Socket.io.
CORS_ORIGINS=http://localhost:3000
# Currency code and Intl locale for prices in notifications and emails
CURRENCY=BDT
CURRENCY_LOCALE=en-BD
# IANA time zone for daily buckets in dashboard charts
TIMEZONE=Asia/Dhaka
# Seconds the admin and moderator dashboard overviews are cached in Redis (0 = no cache)
DASHBOARD_CACHE_SECONDS=60
# Seconds the public homepage data (featured, brands, categories, stats) is cached in Redis (0 = no cache)
HOME_CACHE_SECONDS=300

# ============================================
# Database (PostgreSQL)
# ============================================

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ridex?schema=public
# Separate, disposable database for integration tests (npm test).
# Leave empty to skip integration tests. NEVER point this at DATABASE_URL.
# Run `npx prisma migrate deploy` against it once before testing.
DATABASE_URL_TEST=

# ============================================
# Auth / JWT
# ============================================

# Long random strings. Must match the values in ridex-frontend/.env
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Signs the short-lived Socket.io handshake token (and email unsubscribe links).
# Backend only: the frontend never needs it.
JWT_SOCKET_SECRET=change-me-socket-secret
# Lifetimes (jsonwebtoken format: 15m, 1d, 7d)
SOCKET_TOKEN_EXPIRES_IN=5m
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# Google login (optional). Set ENABLE_GOOGLE_LOGIN=true to turn it on.
# New Google users are created as BUYER; existing accounts are linked by email.
ENABLE_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=

# Auth cookies. "lax" when frontend and API share a site (default),
# "none" when they are on different sites (forces Secure, needs HTTPS).
COOKIE_SAME_SITE=lax
# Optional cookie domain, e.g. .ridex.com.bd (leave empty for host-only)
COOKIE_DOMAIN=

# ============================================
# OTP (email verification, phone OTP, password reset)
# ============================================

# Minutes before a code expires
OTP_EXPIRES_MINUTES=5
# Wrong tries before a code is destroyed
OTP_MAX_ATTEMPTS=5
# Seconds a user must wait before requesting a new code
OTP_RESEND_COOLDOWN_SECONDS=60
# Self-registered accounts with no verified email/phone are deleted after this many hours
UNVERIFIED_USER_TTL_HOURS=24

# ============================================
# SMS (phone OTP)
# ============================================

# "console" prints SMS to the server log (development). Add real gateways in src/app/lib/sms.ts
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# ============================================
# Rate limiting (per IP)
# ============================================

# All /api/v1 routes
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# Login, register, OTP and password-reset endpoints combined, per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# ============================================
# Redis (OTP storage, cache, rate limit, queues)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for a local Redis without auth
REDIS_USER=
REDIS_PASSWORD=

# ============================================
# SMTP (Gmail app password). Optional in development:
# if empty, the server starts and logs a warning instead of sending emails.
# ============================================

SMTP_USER=
SMTP_PASSWORD=

# ============================================
# Cloudinary (image/document uploads)
# ============================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max size per uploaded file in MB
MAX_UPLOAD_SIZE_MB=5

# ============================================
# Listings
# ============================================

# Days an approved listing stays live before the daily cron marks it EXPIRED
LISTING_DURATION_DAYS=60
# Maximum photos per listing
MAX_LISTING_IMAGES=15

# ============================================
# Super Admin (created on first boot if none exists)
# ============================================

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@ridex.demo
SUPER_ADMIN_PASSWORD=change-me-Strong@123

# ============================================
# Demo users (npm run seed). One account per role, all sharing this password.
# admin@ / moderator@ / dealer@ / dealer.staff@ / seller@ / inspector@ / buyer@ ridex.demo
# ============================================

DEMO_USER_PASSWORD=change-me-Demo@123

# ============================================
# Chat
# ============================================

# Messages per user per minute (socket and REST combined)
CHAT_MESSAGE_RATE_LIMIT=30
# New conversations a user can start per hour
CHAT_NEW_CONVERSATION_LIMIT=20
# Minutes before an unread message is emailed (only if still unread and the user is offline)
CHAT_EMAIL_DELAY_MINUTES=10

# ============================================
# Offers
# ============================================

# Hours before an unanswered offer or counter expires
OFFER_EXPIRY_HOURS=48
# Lowest offer allowed, as a percent of the asking price
OFFER_MIN_PERCENT=50
# Offers plus counters allowed in one negotiation
OFFER_MAX_ROUNDS=5

# ============================================
# Test Rides
# ============================================

# A test ride slot must start at least this many hours from now
TEST_RIDE_MIN_LEAD_HOURS=2
# How many days ahead buyers can book a test ride
TEST_RIDE_BOOKING_DAYS=14

# ============================================
# Notifications
# ============================================

# Read notifications older than this many days are deleted daily
NOTIFICATION_RETENTION_DAYS=90
