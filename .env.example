# ============================================
# App
# ============================================

# Brand name used in API messages and emails. Change here to rebrand.
APP_NAME=RideX
# development | production | test
NODE_ENV=development
# Port the API listens on
PORT=5000
# Public URL of this API (used in callbacks and email links)
BACKEND_URL=http://localhost:5000
# Main frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000
# Comma-separated CORS whitelist. Defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000

# ============================================
# Database (PostgreSQL)
# ============================================

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ridex?schema=public

# ============================================
# Auth / JWT
# ============================================

# Long random strings. Must match the values in ridex-frontend/.env
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Lifetimes (jsonwebtoken format: 15m, 1d, 7d)
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# Google login (optional). Set ENABLE_GOOGLE_LOGIN=true to turn it on.
ENABLE_GOOGLE_LOGIN=false
GOOGLE_CLIENT_ID=

# ============================================
# Rate limiting (per IP, applied to /api/v1)
# ============================================

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# ============================================
# Redis (OTP storage, cache, rate limit, queues)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for a local Redis without auth
REDIS_USER=
REDIS_PASSWORD=

# ============================================
# SMTP (Gmail app password). Optional in development:
# if empty, the server starts and logs a warning instead of sending emails.
# ============================================

SMTP_USER=
SMTP_PASSWORD=

# ============================================
# Cloudinary (image/document uploads)
# ============================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max size per uploaded file in MB
MAX_UPLOAD_SIZE_MB=5

# ============================================
# Super Admin (created on first boot if none exists)
# ============================================

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@ridex.demo
SUPER_ADMIN_PASSWORD=change-me-Strong@123

# ============================================
# Demo users (npm run seed). One account per role, all sharing this password.
# admin@ / moderator@ / dealer@ / dealer.staff@ / seller@ / inspector@ / buyer@ ridex.demo
# ============================================

DEMO_USER_PASSWORD=change-me-Demo@123
