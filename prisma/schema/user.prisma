model User {
  id String @id @default(uuid())

  name String

  email String? @unique

  phone String? @unique

  password String?

  googleId String? @unique

  authProvider AuthProvider @default(CREDENTIALS)

  emailVerified Boolean @default(false)

  phoneVerified Boolean @default(false)

  role Role @default(BUYER)

  status UserStatus @default(ACTIVE)

  needPasswordChange Boolean @default(false)

  passwordChangedAt DateTime?

  // ============================================
  // Profile
  // ============================================

  imageUrl String?

  imagePublicId String?

  bio String?

  gender Gender?

  dateOfBirth DateTime?

  division String?

  district String?

  area String?

  // ============================================
  // Moderation
  // ============================================

  blockedReason String?

  blockedAt DateTime?

  blockedById String?

  createdById String?

  // ============================================
  // Trust (denormalised for fast badges and ratings)
  // ============================================

  ratingAverage Float @default(0)

  ratingCount Int @default(0)

  idVerifiedAt DateTime?

  dealerVerifiedAt DateTime?

  // ============================================
  // Soft delete & timestamps
  // ============================================

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  listings Listing[] @relation("SellerListings")

  wishlistItems WishlistItem[]

  recentlyViewed RecentlyViewed[]

  reviewsGiven Review[] @relation("ReviewsGiven")

  reviewsReceived Review[] @relation("ReviewsReceived")

  reportsMade Report[] @relation("ReportsMade")

  reportsAgainst Report[] @relation("ReportsAgainst")

  verificationRequests VerificationRequest[]

  buyerConversations Conversation[] @relation("BuyerConversations")

  sellerConversations Conversation[] @relation("SellerConversations")

  sentMessages Message[] @relation("SentMessages")

  quickReplies QuickReply[]

  blocksMade UserBlock[] @relation("BlocksMade")

  blocksReceived UserBlock[] @relation("BlocksReceived")

  notifications Notification[]

  notificationPreferences NotificationPreference[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([isDeleted])
  @@map("users")
}
