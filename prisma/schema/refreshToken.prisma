model RefreshToken {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String

  expiresAt DateTime

  revokedAt DateTime?

  userAgent String?

  ipAddress String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
