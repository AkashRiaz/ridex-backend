model VehicleModel {
  id String @id @default(uuid())

  brandId String

  vehicleTypeId String

  name String

  // unique per brand, e.g. "r15-v4"
  slug String

  yearFrom Int?

  yearTo Int?

  imageUrl String?

  imagePublicId String?

  // Partial spec values keyed by VehicleType attribute key (auto-fill for listings)
  defaultSpecs Json @default("{}")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)

  @@unique([brandId, name])
  @@unique([brandId, slug])
  @@index([brandId])
  @@index([vehicleTypeId])
  @@index([isActive])
  @@map("vehicle_models")
}
