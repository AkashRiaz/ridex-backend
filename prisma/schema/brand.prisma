model Brand {
  id String @id @default(uuid())

  name String @unique

  slug String @unique

  country String?

  description String?

  logoUrl String?

  logoPublicId String?

  isPopular Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  vehicleTypes BrandVehicleType[]

  models VehicleModel[]

  @@index([isActive])
  @@index([isPopular])
  @@map("brands")
}
