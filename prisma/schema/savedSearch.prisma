/**
 * A search a user saved from /listings, with alert settings.
 * `query` holds the canonical /search/listings params (spec.* included,
 * no page/limit/sortBy), so the alert matcher runs the exact same search.
 */
model SavedSearch {
  id String @id @default(uuid())

  userId String

  name String

  // canonical search params, e.g. { "brand": "honda,yamaha", "maxPrice": "300000" }
  query Json

  // sha256 of the canonical query: the same search can be saved once per user
  queryHash String

  // copied from query.vehicleType so the matcher can pre-filter candidates
  vehicleTypeId String?

  alertFrequency SavedSearchAlertFrequency @default(INSTANT)

  notifyPriceDrops Boolean @default(true)

  // matches newer than this count as "new" on the saved searches page
  lastViewedAt DateTime @default(now())

  lastAlertedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)

  matches SavedSearchMatch[]

  @@unique([userId, queryHash])
  @@index([vehicleTypeId])
  @@index([alertFrequency])
  @@map("saved_searches")
}
